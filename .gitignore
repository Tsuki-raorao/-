# Only publish the reviewed source directories at the repository root.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/agent/
!/backend/
!/frontend/
!/docs/
!/deploy/
!/scripts/

# Private handoffs, infrastructure records, local snapshots and credentials.
/local-private/
/handoff/
/backups/
/reports/
**/.env
**/.env.*
!**/.env.example
!**/.env.template
*.env
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
*.local.properties
*.secret.properties
*.local.yml
*.secret.yml
*.local.yaml
*.secret.yaml
/agent/config/*
!/agent/config/agent.properties
!/agent/config/agent.properties.example

# Dependencies, compiled files, local databases, archives and tool profiles.
node_modules/
dist/
target/
.tools/
.gradle/
.idea/
.vscode/
.DS_Store
Thumbs.db
out/
/agent/out*/
__pycache__/
*.pyc
*.class
*.jar
*.log
*.db
*.db-*
*.sqlite*
*.zip
*.tar
*.gz
*.tgz
*.7z
*.rar
/backend/data/
/data/
*browser-profile*/
