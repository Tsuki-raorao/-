# 复制到服务器 /etc/argus/argus-control-center.env，并设置为 root:argus、权限 0640。
# 不要把真实密码提交到项目或备份。
SPRING_PROFILES_ACTIVE=mysql
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9091
# 仅限后端回环监听、前置 Nginx 覆盖信任头的拓扑；不能向公网暴露此端口。
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_TOMCAT_REDIRECT_CONTEXT_ROOT=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=argus
MYSQL_USER=argus
MYSQL_PASSWORD=
ARGUS_DEMO_DATA_ENABLED=false
# 精确替换成实际入口 origin（协议、地址、端口），无路径/末尾斜杠；这里是 TEST-NET 示例。
ARGUS_CORS_ORIGINS=http://192.0.2.10:9090
ARGUS_AGENT_GATEWAY_ENABLED=false
ARGUS_AGENT_GATEWAY_READ_ONLY=true
ARGUS_AGENT_GATEWAY_ALLOW_CONTROL=false
ARGUS_AGENT_GATEWAY_REQUIRE_ALLOWLIST=true
ARGUS_AGENT_GATEWAY_ALLOWED_HOSTS=
ARGUS_AGENT_AUTH_TOKEN=
# 此次只读发布不开放任务执行；基础令牌不能代替完整登录、权限与审计。
ARGUS_API_READ_ONLY=true
# 未填写访问令牌时拒绝启动；只在受限 EnvironmentFile 中注入真实值。
ARGUS_API_AUTH_REQUIRED=true
ARGUS_API_ACCESS_TOKEN=
ARGUS_API_CONTROL_TOKEN=
ARGUS_TASK_CONTROL_ENABLED=false
ARGUS_TASK_ALLOW_DOCKER=false
ARGUS_TASK_ALLOWED_INSTANCE_IDS=
ARGUS_AGENT_CONTROL_TOKEN=
