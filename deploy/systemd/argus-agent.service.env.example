# 复制到 /etc/argus/argus-agent.service.env，权限 0600；不要提交真实令牌。
ARGUS_AGENT_AUTH_TOKEN=
# 真实模式令牌为空时会拒绝启动；只读 Agent 仍保持控制关闭。
ARGUS_AGENT_MOCK=false
ARGUS_AGENT_CONTROL_ENABLED=false
ARGUS_AGENT_CONTROL_TOKEN=
ARGUS_AGENT_CONTROL_INSTANCES=
# 人工核对独立默认关闭；允许列表是局部实例 ID，仍使用独立控制令牌，不重放原动作。
ARGUS_AGENT_REVIEW_ENABLED=false
ARGUS_AGENT_REVIEW_INSTANCES=
ARGUS_AGENT_DISCOVERY=true
# 同机只读接入先绑定回环；远端节点另选受控网卡地址并限制入站来源。
ARGUS_AGENT_BIND_ADDRESS=127.0.0.1
ARGUS_AGENT_PORT=8090
ARGUS_AGENT_ADVERTISED_HOST=127.0.0.1
# 新节点示例；稳定且唯一，不能在每次发布时随机更换。
ARGUS_AGENT_NODE_ID=node-example
ARGUS_AGENT_NODE_NAME=example-node
# 已有节点必须先核对原 Inbox 路径及 storeId，不能指向空目录或直接覆盖旧目录。
ARGUS_AGENT_TASK_DIR=/var/lib/argus-agent/task-inbox
ARGUS_AGENT_TASK_MAX_RECORDS=10000
