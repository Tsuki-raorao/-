# Argus Agent 生产配置模板（不包含密钥）
# 建议复制为 deployment/agent.properties，密钥通过 ARGUS_AGENT_AUTH_TOKEN 注入。

server.port=8090
# 实际监听地址，仅支持 IPv4/IPv6 字面量；隔离验证用 127.0.0.1，空/无效值拒绝启动。
# 默认保留全接口兼容性；node.advertised-host 只描述访问入口，不控制监听范围。
server.bind-address=0.0.0.0
server.max-http-threads=16
# 有界 HTTP 等待队列；满时调度线程参与执行并形成接收背压，不丢弃已接受请求。
server.max-http-queue=64
server.max-request-bytes=65536
node.id=node-example
node.name=example-node
# 控制中心应访问的实际地址；不要填写 0.0.0.0。
node.advertised-host=127.0.0.1
auth.token=
executor.mock=false
docker.executable=docker
executor.timeout-seconds=30
# 单次命令 stdout/stderr 合并输出的字节上限；超限失败，不返回截断的容器清单。
executor.max-output-bytes=1048576
executor.max-concurrent-tasks=4
# 远程 start/stop/restart 默认关闭；只有完成权限、审计和备份配置后才显式开启。
control.enabled=false
# 读取令牌与控制令牌必须不同，真实值通过环境变量注入，不写进仓库。
control.token=
# 控制采用独立允许列表，自动发现容器不等于获得控制权限。
control.instances=
# 人工核对只记录接纳不确定性，不执行原动作；与 control.enabled 独立，默认关闭。
review.enabled=false
review.instances=
# 默认仅控制开启、显式配置目录或发现既有 store.id 时打开 Inbox。
# task.directory=agent/data/task-inbox
task.max-records=10000
instance.id=mc01
instance.container=mc01
# true 时自动读取 docker ps -a，展示节点上的全部容器；只读模式下不会执行容器动作。
instance.discovery=true
